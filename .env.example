
PORT=5055
MONGO_URI=your mongodb url
JWT_SECRET=your_jwt_secret
JWT_SECRET_FOR_VERIFY=your_jwt_verify_secret


# you must need to add this 32digit hex random key in both admin and backend same key, otherwish roles based will not work. you can generate by this command
# openssl rand -hex 32

ENCRYPT_PASSWORD=your_32_byte_hex_key





STRIPE_KEY=your Secret key
MAX_AMOUNT=10000.0
MIN_AMOUNT =10.0
AMOUNT_STEP =5.0
CURRENCY=usd
STRIPE_PAYMENT_DESCRIPTION="This is Bangla Bazar payment with Stripe!"


# if you want to use gmail/email sent for email verfication or forget password then bellow .env
# need to configure otherwise no need to configure. As per the google they not recomaned to use app password 
# https://support.google.com/accounts/answer/185833?hl=en, so you can use paid smpt service or use current next auth.

SERVICE=gmail
EMAIL_USER=your email
EMAIL_PASS=your 16digit email app password 
HOST=smtp.gmail.com
EMAIL_PORT=465

//when in production mode use this
STORE_URL=your store live url
ADMIN_URL=your admin live url


# --- TypeScript server (src/) ---
# Refresh tokens are signed with their own secret — openssl rand -hex 32
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRATION=7d
JWT_EXPIRATION=1d

# The rewrite reads EMAIL_PASSWORD / EMAIL_HOST, not the legacy EMAIL_PASS / HOST above.
EMAIL_PASSWORD=your 16digit email app password
EMAIL_HOST=smtp.gmail.com
EMAIL_SECURE=true
EMAIL_FROM=Bangla Bazar <no-reply@your-domain.com>

# Registration OTPs live in Redis.
REDIS_URL=redis://localhost:6379
# The code's lifetime is also the resend cooldown — one live code per identifier.
OTP_CODE_TTL_SECONDS=300
OTP_PENDING_TTL_SECONDS=1800
OTP_MAX_ATTEMPTS=5

# Reset codes are exchanged for this token, which authorises the actual password change.
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
REFRESH_COOKIE_MAX_AGE_MS=2592000000
# The browser only returns the refresh cookie for this origin (cors credentials).
CLIENT_URL=http://localhost:3000

# Read only by `npm run seed:superadmin` — no HTTP route can create a superAdmin.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@your-domain.com
SUPERADMIN_PASSWORD=at-least-8-characters
