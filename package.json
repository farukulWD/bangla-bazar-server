{
  "name": "bangla-bazar-backend",
  "version": "0.1.0",
  "description": "this is the server of Bangla Bazar built with node, express, mongoose schema validation and use mongodb as a database",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed:superadmin": "tsx src/scripts/seedSuperAdmin.ts",
    "seed:roles": "tsx src/scripts/seedRoles.ts",
    "seed:settings": "tsx src/scripts/seedSettings.ts",
    "seed:currencies": "tsx src/scripts/seedCurrencies.ts",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "sync:permissions": "tsx src/scripts/seedRoles.ts --sync",
    "migrate:products": "tsx src/scripts/migrateProducts.ts",
    "migrate:order-currency": "tsx src/scripts/migrateOrderCurrency.ts"
  },
  "author": "Bangla Bazar",
  "license": "Regular",
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.10.7",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^5.0.2",
    "http-status": "^2.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "libphonenumber-js": "^1.13.12",
    "mailchecker": "^6.0.15",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "nodemailer": "^6.7.2",
    "pdfkit": "^0.16.0",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.4",
    "socket.io": "^4.7.2",
    "stripe": "^9.14.0",
    "twilio": "^5.4.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
