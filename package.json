{
  "name": "bangla-bazar-backend",
  "version": "0.1.0",
  "description": "this is the server of Bangla Bazar built with node, express, mongoose schema validation and use mongodb as a database",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon api/index.js",
    "dev:ts": "tsx watch src/server.ts",
    "start": "node api/index.js",
    "start:ts": "node dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "production": "NODE_ENV=production nodemon api/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "data:import": "node script/seed.js",
    "product": "node script/product.js",
    "generate-password": "node script/script.js"
  },
  "author": "Bangla Bazar",
  "license": "Regular",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dayjs": "^1.10.7",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-rate-limit": "^6.1.0",
    "helmet": "^5.0.2",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.0",
    "mailchecker": "^6.0.15",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "nodemailer": "^6.7.2",
    "pdfkit": "^0.16.0",
    "razorpay": "^2.9.4",
    "socket.io": "^4.7.2",
    "stripe": "^9.14.0",
    "twilio": "^5.4.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.17.6",
    "nodemon": "^3.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
